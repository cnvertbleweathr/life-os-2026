STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
STRAVA_REDIRECT_URI=http://localhost:8000/callback
HARDCOVER_TOKEN=replace_me
HARDCOVER_API_URL=https://api.hardcover.app/v1/graphql
GOOGLE_CALENDAR_CREDENTIALS=secrets/google_calendar_credentials.json
GOOGLE_CALENDAR_TOKEN=secrets/google_calendar_token.json
# calendar_export syncs every calendar on the account; GOOGLE_CALENDAR_ID is no longer used.
# Phone notifications are off. Set to 1 to opt back in to ntfy pushes (e.g. calendar sign-in expired).
ONS_PHONE_NOTIFICATIONS=0
SPOTIFY_CLIENT_ID=replace_me
SPOTIFY_CLIENT_SECRET=replace_me
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback
SPOTIFY_TEWNIDGE_PLAYLIST_ID=7hxa1w4AzUjm6xgvU3Zf3x
SPOTIFY_DEEDS_PLAYLIST_ID=6GP6ERcYJArZ7WWaC2g0Xv
PIXELA_USERNAME=cnvertbleweathr
PIXELA_TOKEN=replace_me
PIXELA_TIMEZONE=America/Denver
AEG_EVENTS_URLS=https://aegwebprod.blob.core.windows.net/json/events/89/events.json|https://aegwebprod.blob.core.windows.net/json/events/37/events.json|https://aegwebprod.blob.core.windows.net/json/events/7/events.json|https://aegwebprod.blob.core.windows.net/json/events/44/events.json|https://aegwebprod.blob.core.windows.net/json/events/2/events.json
TICKETMASTER_API_KEY=__PUT_YOUR_KEY_HERE__
TM_CITY=Denver
TM_STATE=CO
TM_COUNTRY=US
TM_RADIUS_MILES=50
TM_CLASSIFICATION=music
TM_SIZE=200
OPENAI_API_KEY=_PUT_YOUR_KEY_HERE__
LASTFM_API_KEY=replace_me
AUDIODB_API_KEY=replace_me
YOUTUBE_API_KEY=replace_me

# Write key for personal endpoints (habit logging, check-in, Capture inbox)
# when reached through Cloudflare. Unset = those endpoints refuse public traffic.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ONS_WRITE_TOKEN=replace_me

# Dead-man's switches (healthchecks.io ping URLs, e.g. https://hc-ping.com/<uuid>)
# HEARTBEAT_URL: pinged every 5 min by ops/macmini/heartbeat.sh (period 5m, grace 15m)
# HEALTHCHECK_SYNC_URL: pinged by daily_sync.py at start/end (daily, grace 2h)
HEARTBEAT_URL=
HEALTHCHECK_SYNC_URL=

# Off-machine backups (ops/macmini/offsite_backup.sh, 2:30am).
# BACKUP_OFFSITE_DEST: user@host:path over SSH (path relative to that user's home),
#   e.g. kg@plex-server:ons-backups. Unset = offsite copy is skipped.
# BACKUP_OFFSITE_DAYS: days of copies kept there (default 30).
# HEALTHCHECK_BACKUP_URL: optional healthchecks.io check (cron 30 2 * * *, America/Denver, grace 1h)
BACKUP_OFFSITE_DEST=
BACKUP_OFFSITE_DAYS=30
HEALTHCHECK_BACKUP_URL=

# Check-in packet (checkin/): posted to a private Slack channel as the last daily_sync step.
# SLACK_CHECKIN_WEBHOOK_URL: Slack incoming webhook for that channel (secret; never commit).
# ONS_CHECKIN_CADENCE: daily (default) | weekdays | weekly:<day>, e.g. weekly:sun
SLACK_CHECKIN_WEBHOOK_URL=
ONS_CHECKIN_CADENCE=daily

# Morning brief printing: automatic prints wait until this time (HH:MM, default 05:00).
ONS_PRINT_AT=05:00
# No automatic printing after this time (HH:MM, default 06:00). The 5:00 job retries every 10 min until then.
ONS_PRINT_UNTIL=06:00
