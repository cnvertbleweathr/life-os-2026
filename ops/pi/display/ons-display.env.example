# /etc/default/ons-display — settings for ons-display.service

# The Mac mini's API over Tailscale (the API listens on 0.0.0.0:8000; Tailscale
# requests count as the owner, so the panel gets the private plex_clip loops).
ONS_API=http://<mac-mini-tailscale-ip>:8000

# rpi-rgb-led-matrix settings. Adafruit RGB Matrix Bonnet/HAT: adafruit-hat
# (or adafruit-hat-pwm after the PWM solder bridge). A plain adapter: regular.
LED_GPIO_MAPPING=adafruit-hat
LED_BRIGHTNESS=60
# Pi 4 drives GPIO faster than most panels like; 2–4 stops flicker.
LED_SLOWDOWN_GPIO=2
